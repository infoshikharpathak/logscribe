# Copy this file to .env and fill in your keys.

# OpenAI (used by the default analyzer for root-cause analysis)
OPENAI_API_KEY=sk-...

# Analyzer backend: "openai" (default, direct OpenAI call) or "agent_forge"
# (routes root-cause analysis through agent-forge's registered "logscribe" app).
# LOGSCRIBE_ANALYZER=agent_forge

# Only used when LOGSCRIBE_ANALYZER=agent_forge.
# AGENT_FORGE_URL=http://localhost:8000

# Optional, only used when LOGSCRIBE_ANALYZER=agent_forge. Path to the git repo
# of the service being monitored. When set, agent-forge's locked "logscribe" app
# uses its git tools (git_log/git_show/git_diff, read-only) to check whether a
# recent commit correlates with the error.
# LOGSCRIBE_REPO_PATH=/path/to/monitored/service
